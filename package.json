{
  "name": "3x4-foto-studio",
  "productName": "3x4 Foto Studio",
  "version": "1.0.0",
  "description": "3x4 hujjat rasmlari: orqa fonni avtomatik o'chirish, kiyim almashtirish va chop etishga tayyorlash",
  "author": "Karimov Og'abek",
  "license": "UNLICENSED",
  "private": true,
  "main": "app/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogabek-karimov/3x4photo.git"
  },
  "scripts": {
    "prepare": "node scripts/prepare-assets.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build:renderer && electron-builder --win dir"
  },
  "devDependencies": {
    "@imgly/background-removal-data": "1.4.5",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "@imgly/background-removal": "1.7.0",
    "@vladmandic/face-api": "^1.7.15",
    "onnxruntime-web": "1.21.0"
  },
  "build": {
    "appId": "uz.karimov.foto3x4",
    "productName": "3x4 Foto Studio",
    "copyright": "© Karimov Og'abek",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3x4 Foto Studio",
      "artifactName": "3x4-Foto-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "3x4-Foto-Studio-Portable-${version}.${ext}"
    }
  }
}
